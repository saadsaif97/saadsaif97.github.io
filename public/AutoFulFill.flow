71c7d1635521bce21ccf95532aa2663b3a4524b222c5faf33b27c59629d25020:{"__metadata":{"version":0.1},"root":{"steps":[{"step_id":"01KS390Q99NMRVG3Y5QWMNMWB8","step_position":[0,-240],"config_field_values":[],"task_id":"shopify::admin::order_created","task_version":"0.1","task_type":"TRIGGER","description":null,"note":null,"name":null},{"step_id":"01KS39PT41CJMJZ5TPWZN7X1MK","step_position":[0,-40],"config_field_values":[{"config_field_id":"input","value":"query{\n  order {\n    fulfillmentOrders {\n      id\n      status\n      lineItems {\n        id\n        totalQuantity\n        sku\n      }\n    }\n  }\n}"},{"config_field_id":"script","value":"export default function main(input) {\n  // Define the target SKU you want to filter and auto-fulfill\n  const TARGET_SKU = \"FULL\"; \n  \n  let fulfillmentOrderId = \"\";\n  let lineItemId = \"\";\n  let quantity = 0;\n  let shouldFulfill = false;\n\n  // Access the array of fulfillment orders from your input query\n  const fulfillmentOrders = input.order?.fulfillmentOrders || [];\n\n  // 1. Loop through each fulfillment order\n  for (const fo of fulfillmentOrders) {\n    const lineItems = fo.lineItems || [];\n    \n    // 2. Loop through the line items inside this fulfillment order\n    for (const item of lineItems) {\n      \n      // 3. Match against your target SKU (Ensure SKU is queried or use another identifier)\n      if (item.sku === TARGET_SKU || item.id === TARGET_SKU) { \n        fulfillmentOrderId = fo.id;\n        lineItemId = item.id;\n        quantity = item.totalQuantity;\n        shouldFulfill = true;\n        break; // Exit item loop\n      }\n    }\n    if (shouldFulfill) break; // Exit fulfillment order loop if found\n  }\n\n  // Return the data to the next steps in your Shopify Flow\n  return {\n    shouldFulfill: shouldFulfill,\n    fulfillmentOrderId: fulfillmentOrderId,\n    lineItemId: lineItemId,\n    quantity: quantity\n  };\n}\n"},{"config_field_id":"output_schema","value":"type Output {\n  \"Whether the target item was found and needs fulfillment\"\n  shouldFulfill: Boolean!\n  \"The ID of the fulfillment order containing the item\"\n  fulfillmentOrderId: String!\n  \"The ID of the specific line item to fulfill\"\n  lineItemId: String!\n  \"The quantity of the item to fulfill\"\n  quantity: Int!\n}\n"}],"task_id":"shopify::flow::run_code","task_version":"0.1","task_type":"ACTION","description":null,"note":null,"name":"Run code"},{"step_id":"01KS3AHXA0H3N3CN4KGKZZ8H55","step_position":[0,60],"config_field_values":[{"config_field_id":"condition","value":"{\"uuid\":\"01KS3AJ3JAEJZW175QAATDJA3D\",\"lhs\":{\"uuid\":\"01KS3AHZV0PZM32NMTXNYP8YYJ\",\"parent_uuid\":\"01KS3AJ3JAEJZW175QAATDJA3D\",\"lhs\":{\"uuid\":\"01KS3AJ3JAGT5XTM7BSK1GVP36\",\"parent_uuid\":\"01KS3AHZV0PZM32NMTXNYP8YYJ\",\"value\":\"runCode.shouldFulfill\",\"comparison_value_type\":\"EnvironmentValue\",\"full_environment_path\":\"runCode.shouldFulfill\"},\"rhs\":{\"uuid\":\"01KS3AJ71DA1CKBZ9ZJXVQ7VC3\",\"parent_uuid\":\"01KS3AHZV0PZM32NMTXNYP8YYJ\",\"value\":\"true\",\"comparison_value_type\":\"LiteralValue\"},\"value_type\":\"EnvironmentScalarDefinition:Boolean\",\"operator\":\"==\",\"operation_type\":\"Comparison\"},\"operator\":\"AND\",\"operation_type\":\"LogicalExpression\"}"}],"task_id":"shopify::flow::condition","task_version":"0.1","task_type":"CONDITION","description":null,"note":null,"name":null},{"step_id":"01KS3AT7YVQN47Z6HRVK9MRJ3N","step_position":[-160,220],"config_field_values":[{"config_field_id":"api_call","value":"{\"name\":\"fulfillmentCreateV2\",\"blob\":\"{\\n  \\\"fulfillment\\\": {\\n    \\\"notifyCustomer\\\": false,\\n    \\\"lineItemsByFulfillmentOrder\\\": [\\n      {\\n        \\\"fulfillmentOrderId\\\": \\\"{{runCode.fulfillmentOrderId}}\\\",\\n        \\\"fulfillmentOrderLineItems\\\": [\\n          {\\n            \\\"id\\\": \\\"{{runCode.lineItemId}}\\\",\\n            \\\"quantity\\\": {{runCode.quantity}}\\n          }\\n        ]\\n      }\\n    ]\\n  },\\n  \\\"message\\\": \\\"auto fulfilled\\\"\\n}\"}"}],"task_id":"shopify::admin::admin_api_operation","task_version":"0.1","task_type":"ACTION","description":null,"note":null,"name":"Send Admin API request"},{"step_id":"01KS3AXVKP906XRHT6X0YRSSJV","step_position":[-160,360],"config_field_values":[{"config_field_id":"fulfillment_order_id","value":"{\"value\":\"{{sendAdminApiRequest.fulfillment.id}}\",\"default_value\":\"\"}"},{"config_field_id":"message","value":""},{"config_field_id":"notify_customer","value":"false"}],"task_id":"shopify::admin::fulfillment_order_mark_as_fulfilled","task_version":"0.1","task_type":"ACTION","description":null,"note":null,"name":null}],"links":[{"from_step_id":"01KS390Q99NMRVG3Y5QWMNMWB8","from_port_id":"output","to_step_id":"01KS39PT41CJMJZ5TPWZN7X1MK","to_port_id":"input"},{"from_step_id":"01KS39PT41CJMJZ5TPWZN7X1MK","from_port_id":"output","to_step_id":"01KS3AHXA0H3N3CN4KGKZZ8H55","to_port_id":"input"},{"from_step_id":"01KS3AHXA0H3N3CN4KGKZZ8H55","from_port_id":"true","to_step_id":"01KS3AT7YVQN47Z6HRVK9MRJ3N","to_port_id":"input"},{"from_step_id":"01KS3AT7YVQN47Z6HRVK9MRJ3N","from_port_id":"output","to_step_id":"01KS3AXVKP906XRHT6X0YRSSJV","to_port_id":"input"}],"patched_fields":[],"variables":[],"note":null,"vertical_layout_enabled":true,"workflow_name":"AutoFulFill"}}
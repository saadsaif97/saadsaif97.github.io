0f2ef6c2449d7b19101f62a464c5c51f0936d8cb71083f150bb973cf13b07ac0:{"__metadata":{"version":0.1},"root":{"steps":[{"step_id":"01KQM5J7H1FXKN91TVD7WAD576","step_position":[20,-220],"config_field_values":[],"task_id":"shopify::admin::order_created","task_version":"0.1","task_type":"TRIGGER","description":null,"note":null,"name":null},{"step_id":"01KQM5VFHD9BD1VMMFDJ58NX3K","step_position":[20,-20],"config_field_values":[{"config_field_id":"input","value":"query {\n  order {\n    lineItems {\n      variant {\n        product {\n          id\n          metafields {\n            key\n            namespace\n            value\n          }\n        }\n      }\n    }\n  }\n}\n"},{"config_field_id":"script","value":"export default function main(input) {\n  const products = input.order.lineItems.map(item => item.variant.product);\n\n  // Deduplicate by numeric product ID\n  const seen = new Set();\n  const uniqueProducts = [];\n  for (const p of products) {\n    const id = p.id.split('/').pop();\n    if (!seen.has(id)) { seen.add(id); uniqueProducts.push({ id, product: p }); }\n  }\n\n  const productIds = uniqueProducts.map(p => p.id);\n\n  if (productIds.length < 2) return { productUpdates: [] };\n\n  // Load each product's existing bought_together data from its metafields array\n  const dataMap = {};\n  for (const { id, product } of uniqueProducts) {\n    const mf = product.metafields.find(\n      m => m.namespace === 'custom' && m.key === 'bought_together'\n    );\n    dataMap[id] = mf ? JSON.parse(mf.value) : {};\n  }\n\n  // Increment co-purchase count for every pair in this order\n  for (const a of productIds) {\n    for (const b of productIds) {\n      if (a === b) continue;\n      dataMap[a][b] = (dataMap[a][b] || 0) + 1;\n    }\n  }\n\n  return {\n    productUpdates: productIds.map(id => ({\n      productGid: `gid://shopify/Product/${id}`,\n      boughtTogether: JSON.stringify(dataMap[id]),\n    })),\n  };\n}\n"},{"config_field_id":"output_schema","value":"\"The output of Run Code\"\ntype Output {\n  \"Per-product metafield updates\"\n  productUpdates: [ProductUpdate!]!\n}\n\ntype ProductUpdate {\n  productGid: String!\n  boughtTogether: String!\n}\n"}],"task_id":"shopify::flow::run_code","task_version":"0.1","task_type":"ACTION","description":null,"note":null,"name":"Run code"},{"step_id":"01KQMV955WCEJE5F8DF11MZYX9","step_position":[20,80],"config_field_values":[{"config_field_id":"listpath","value":"runCode.productUpdates"}],"task_id":"shopify::flow::foreach","task_version":"0.1","task_type":"FOREACH","description":null,"note":null,"name":null},{"step_id":"01KQMVA74CT43X005WWJXJJSW7","step_position":[200,240],"config_field_values":[{"config_field_id":"product_id","value":"{\"value\":\"{{productUpdatesForeachitem.productGid}}\",\"default_value\":\"\"}"},{"config_field_id":"metafield","value":"{\"namespace\":\"custom\",\"key\":\"bought_together\",\"type\":\"json\"}"},{"config_field_id":"value","value":"{{productUpdatesForeachitem.boughtTogether}}"}],"task_id":"shopify::admin::add_product_metafield","task_version":"1.0","task_type":"ACTION","description":null,"note":null,"name":null}],"links":[{"from_step_id":"01KQM5J7H1FXKN91TVD7WAD576","from_port_id":"output","to_step_id":"01KQM5VFHD9BD1VMMFDJ58NX3K","to_port_id":"input"},{"from_step_id":"01KQM5VFHD9BD1VMMFDJ58NX3K","from_port_id":"output","to_step_id":"01KQMV955WCEJE5F8DF11MZYX9","to_port_id":"input"},{"from_step_id":"01KQMV955WCEJE5F8DF11MZYX9","from_port_id":"loop_body","to_step_id":"01KQMVA74CT43X005WWJXJJSW7","to_port_id":"input"}],"patched_fields":[],"variables":[],"note":null,"vertical_layout_enabled":true,"workflow_name":"Bought together"}}
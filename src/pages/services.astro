---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const title = "Shopify Development Services | EcomWonk";
const description =
  "Hire Saad Saif for custom Shopify development, conversion rate optimisation, AOV-boosting features, app replacement, and Shopify Plus solutions. 4+ years, 100+ stores.";

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "EcomWonk, Shopify Development Services",
  url: SITE.website,
  description,
  provider: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
    jobTitle: "Freelance Shopify Developer",
    sameAs: [
      "https://www.linkedin.com/in/saadsaif97",
      "https://github.com/saadsaif97",
      "https://www.youtube.com/@saadsaif97",
    ],
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Shopify Development Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Conversion Rate Optimisation",
          description:
            "Improve product pages, checkout flow, and mobile UX to turn more visitors into buyers.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Average Order Value Features",
          description:
            "Custom upsells, bundles, quantity discounts, and free-gift thresholds built without expensive apps.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "App Replacement Development",
          description:
            "Replace slow, costly Shopify apps with lightweight custom-coded equivalents that own your store's performance.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Shopify Plus Development",
          description:
            "Checkout UI extensions, custom checkout flows, and advanced theme builds for Shopify Plus merchants.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Store Speed & Performance",
          description:
            "Remove app bloat, improve Core Web Vitals, and speed up your Shopify store for better SEO and conversions.",
        },
      },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What kind of Shopify stores do you work with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "I work with Shopify and Shopify Plus stores of all sizes, from DTC brands doing their first $1M to established merchants scaling past $10M. My focus is always on revenue impact: conversion rate, average order value, and store performance.",
      },
    },
    {
      "@type": "Question",
      name: "Do you replace Shopify apps with custom code?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Many common Shopify apps, bundle builders, frequently bought together, infinite scroll, product badges, can be rebuilt as lightweight custom code. This cuts monthly app fees and usually results in a faster, cleaner store.",
      },
    },
    {
      "@type": "Question",
      name: "How do I get started?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The easiest way is to request a free Shopify revenue audit. Share your store URL and I will personally review it and identify your highest-impact opportunities, conversion bottlenecks, missed upsell moments, speed issues, and app replacement candidates.",
      },
    },
    {
      "@type": "Question",
      name: "Do you work with agencies or only direct clients?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "I work directly with store owners and brands, no agencies, no middlemen. You talk to the developer doing the work from day one.",
      },
    },
    {
      "@type": "Question",
      name: "Do you offer ongoing support after a project?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. I offer ongoing retainer support for stores that need regular development work, bug fixes, and iterative improvements after the initial project.",
      },
    },
  ],
};
---

<Layout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(professionalServiceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <Header />

  <main id="main-content" class="mx-auto w-full max-w-app px-4">

    <!-- ═══ HERO ═══ -->
    <section class="py-16 sm:py-20">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-green-800 bg-green-950/60 px-4 py-1.5 text-xs font-medium text-green-400">
        <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
        Available for New Projects
      </div>
      <h1 class="mb-5 text-4xl font-bold leading-tight sm:text-5xl">
        Shopify Development<br />
        <span class="text-green-400">Services & Pricing</span>
      </h1>
      <p class="mb-8 max-w-xl text-foreground/70">
        Custom Shopify development focused on revenue, conversion rate optimisation, AOV-boosting
        features, app replacement, and Shopify Plus solutions. 4+ years experience across 100+
        stores, including 20+ Shopify Plus projects.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit, my Shopify store url is ..."
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-green-500 px-6 py-3 text-sm font-semibold text-black transition hover:bg-green-400"
        >
          Get Free Revenue Audit
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="https://calendly.com/saadgfx97/shopify-theme-development"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-700 bg-zinc-900/60 px-6 py-3 text-sm font-semibold text-foreground transition hover:border-zinc-500"
        >
          Book a Discovery Call
        </a>
      </div>
    </section>

    <!-- ═══ SERVICES ═══ -->
    <section class="py-16">
      <h2 class="mb-3 text-2xl font-bold sm:text-3xl">What I Build</h2>
      <p class="mb-10 max-w-xl text-foreground/60 text-sm">
        Every project is custom-coded, no page-builder shortcuts, no bloated apps, just clean,
        performant Liquid and JavaScript that your team can maintain.
      </p>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

        <!-- CRO -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-green-800/50 bg-green-950/60 text-green-400">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <h3 class="mb-2 font-semibold text-lg">Conversion Rate Optimisation</h3>
          <p class="mb-4 text-sm text-foreground/60">
            Identify and fix the friction between a visitor and a purchase. I audit your
            product pages, collection pages, cart, and checkout, then implement targeted
            improvements, better UX, clearer CTAs, faster load times, and mobile
            optimisation.
          </p>
          <ul class="space-y-1.5 text-sm text-foreground/70">
            {["Product page redesign", "Checkout flow improvements", "Mobile UX fixes", "A/B test implementation", "Core Web Vitals optimisation"].map(item => (
              <li class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 shrink-0 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- AOV -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-green-800/50 bg-green-950/60 text-green-400">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <h3 class="mb-2 font-semibold text-lg">Average Order Value Features</h3>
          <p class="mb-4 text-sm text-foreground/60">
            Extract more revenue from every order you already win. I build custom
            upsell and cross-sell features, all without the recurring cost and
            performance hit of third-party apps.
          </p>
          <ul class="space-y-1.5 text-sm text-foreground/70">
            {["Quantity bundle discounts", "Frequently bought together", "Free gift with purchase", "Cart upsells & cross-sells", "Custom bundle builder"].map(item => (
              <li class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 shrink-0 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- App Replacement -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-green-800/50 bg-green-950/60 text-green-400">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="mb-2 font-semibold text-lg">App Replacement Development</h3>
          <p class="mb-4 text-sm text-foreground/60">
            Shopify apps add up fast, $20 here, $49 there, and they slow your store down.
            I build the same functionality as native, lightweight code. One-time cost, zero
            monthly fees, full control.
          </p>
          <ul class="space-y-1.5 text-sm text-foreground/70">
            {["Wishlist (no app)", "Infinite scroll (no app)", "Product badges & labels", "Size / colour swatches", "Recently viewed products"].map(item => (
              <li class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 shrink-0 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Shopify Plus -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-green-800/50 bg-green-950/60 text-green-400">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3 class="mb-2 font-semibold text-lg">Shopify Plus Development</h3>
          <p class="mb-4 text-sm text-foreground/60">
            20+ Shopify Plus projects delivered. I work confidently with checkout UI
            extensions, custom scripts (legacy), Shopify Functions, and complex multi-market
            setups that require deeper platform knowledge.
          </p>
          <ul class="space-y-1.5 text-sm text-foreground/70">
            {["Checkout UI extensions", "Custom checkout flows", "Shopify Functions", "B2B / wholesale features", "Multi-market / multi-language"].map(item => (
              <li class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 shrink-0 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- ═══ WHY CHOOSE ═══ -->
    <section class="py-16">
      <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl">Why Hire a Specialist, Not a Generalist</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {[
          {
            title: "Shopify-Only Focus",
            desc: "I work exclusively in Shopify. That depth means I know the platform edge cases, performance pitfalls, and undocumented APIs that a generalist misses.",
          },
          {
            title: "You Talk to the Developer",
            desc: "No project managers, no account handlers, no translation layer. You explain something once, directly to the person writing the code.",
          },
          {
            title: "Revenue-First Thinking",
            desc: "Features are only worth building if they move a metric, conversion rate, AOV, or margin. I help you decide what to build before writing a line of code.",
          },
        ].map(({ title, desc }) => (
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-6">
            <div class="mb-3 flex h-8 w-8 items-center justify-center rounded-full bg-green-500 text-sm font-bold text-black">✓</div>
            <h3 class="mb-2 font-semibold">{title}</h3>
            <p class="text-sm text-foreground/60">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ FREE AUDIT CTA ═══ -->
    <section class="py-8">
      <div class="rounded-2xl border border-green-900/60 bg-green-950/30 p-8 sm:p-10">
        <div class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-green-400">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Best Starting Point
        </div>
        <h2 class="mb-3 text-2xl font-bold sm:text-3xl">Free Shopify Revenue Audit</h2>
        <p class="mb-6 max-w-xl text-sm text-foreground/70">
          Not sure where to start? Send me your store URL and I'll personally review your store
          and record a Loom video walking through:
        </p>
        <div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-2 max-w-lg">
          {[
            "Conversion bottlenecks",
            "Missed upsell opportunities",
            "Speed & Core Web Vitals issues",
            "App replacement opportunities",
            "Mobile UX problems",
            "Estimated revenue impact",
          ].map(item => (
            <div class="flex items-center gap-2 text-sm">
              <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-500/20">
                <svg class="h-3 w-3 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
              </div>
              {item}
            </div>
          ))}
        </div>
        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit, my Shopify store url is ..."
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg bg-green-500 px-8 py-3.5 text-sm font-semibold text-black transition hover:bg-green-400"
        >
          Request Free Audit
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <p class="mt-3 text-xs text-foreground/40">No obligation. No sales pressure.</p>
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <section class="py-16 pb-24">
      <h2 class="mb-10 text-2xl font-bold sm:text-3xl">Frequently Asked Questions</h2>
      <div class="space-y-4 max-w-3xl">
        {[
          {
            q: "What kind of Shopify stores do you work with?",
            a: "I work with Shopify and Shopify Plus stores of all sizes, from DTC brands doing their first $1M to established merchants scaling past $10M. My focus is always on revenue impact: conversion rate, average order value, and store performance.",
          },
          {
            q: "Do you replace Shopify apps with custom code?",
            a: "Yes. Many common Shopify apps, wishlists, bundle builders, frequently bought together, infinite scroll, product badges, can be rebuilt as lightweight custom code. This cuts monthly app fees and usually results in a faster, cleaner store.",
          },
          {
            q: "How do I get started?",
            a: "The easiest way is to request a free Shopify revenue audit. Share your store URL and I'll personally review it and identify your highest-impact opportunities, conversion bottlenecks, missed upsell moments, speed issues, and app replacement candidates.",
          },
          {
            q: "Do you work with agencies or only direct clients?",
            a: "I work directly with store owners and brands, no agencies, no middlemen. You talk to the developer doing the work from day one.",
          },
          {
            q: "Do you offer ongoing support after a project?",
            a: "Yes. I offer ongoing retainer support for stores that need regular development work, bug fixes, and iterative improvements after the initial project.",
          },
        ].map(({ q, a }) => (
          <details class="group rounded-xl border border-zinc-800 bg-zinc-900/50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-medium">
              {q}
              <svg class="h-4 w-4 shrink-0 text-foreground/50 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <p class="border-t border-zinc-800 px-5 pb-5 pt-4 text-sm text-foreground/70">{a}</p>
          </details>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</Layout>

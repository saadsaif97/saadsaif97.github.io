---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
import { SITE } from "@/config";

const title = "Shopify Development Services | EcomWonk";
const description =
  "Hire Saad Saif for custom Shopify development, conversion rate optimisation, AOV-boosting features, app replacement, and Shopify Plus solutions. 4+ years, 100+ stores.";

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "EcomWonk, Shopify Development Services",
  url: SITE.website,
  description,
  provider: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
    jobTitle: "Freelance Shopify Developer",
    sameAs: [
      "https://www.linkedin.com/in/saadsaif97",
      "https://github.com/saadsaif97",
      "https://www.youtube.com/@saadsaif97",
    ],
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Shopify Development Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Conversion Rate Optimisation",
          description:
            "Improve product pages, checkout flow, and mobile UX to turn more visitors into buyers.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Average Order Value Features",
          description:
            "Custom upsells, bundles, quantity discounts, and free-gift thresholds built without expensive apps.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "App Replacement Development",
          description:
            "Replace slow, costly Shopify apps with lightweight custom-coded equivalents that own your store's performance.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Shopify Plus Development",
          description:
            "Checkout UI extensions, custom checkout flows, and advanced theme builds for Shopify Plus merchants.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Store Speed & Performance",
          description:
            "Remove app bloat, improve Core Web Vitals, and speed up your Shopify store for better SEO and conversions.",
        },
      },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What kind of Shopify stores do you work with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "I work with Shopify and Shopify Plus stores of all sizes, from DTC brands doing their first $1M to established merchants scaling past $10M. My focus is always on revenue impact: conversion rate, average order value, and store performance.",
      },
    },
    {
      "@type": "Question",
      name: "Do you replace Shopify apps with custom code?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Many common Shopify apps, bundle builders, frequently bought together, infinite scroll, product badges, can be rebuilt as lightweight custom code. This cuts monthly app fees and usually results in a faster, cleaner store.",
      },
    },
    {
      "@type": "Question",
      name: "How do I get started?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The easiest way is to request a free Shopify revenue audit. Share your store URL and I will personally review it and identify your highest-impact opportunities, conversion bottlenecks, missed upsell moments, speed issues, and app replacement candidates.",
      },
    },
    {
      "@type": "Question",
      name: "Do you work with agencies or only direct clients?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "I work directly with store owners and brands, no agencies, no middlemen. You talk to the developer doing the work from day one.",
      },
    },
    {
      "@type": "Question",
      name: "Do you offer ongoing support after a project?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. I offer ongoing retainer support for stores that need regular development work, bug fixes, and iterative improvements after the initial project.",
      },
    },
  ],
};

const CALENDLY_URL = "https://calendly.com/saadgfx97/shopify-theme-development";
const WHATSAPP_URL =
  "https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit, my Shopify store url is ...";

const services = [
  {
    title: "Conversion Rate Optimisation",
    description:
      "Identify and fix the friction between a visitor and a purchase. I audit your product pages, collection pages, cart, and checkout, then implement targeted improvements.",
    items: [
      "Product page redesign",
      "Checkout flow improvements",
      "Mobile UX fixes",
      "A/B test implementation",
      "Core Web Vitals optimisation",
    ],
  },
  {
    title: "Average Order Value Features",
    description:
      "Extract more revenue from every order you already win. I build custom upsell and cross-sell features, without the recurring cost and performance hit of third-party apps.",
    items: [
      "Quantity bundle discounts",
      "Frequently bought together",
      "Free gift with purchase",
      "Cart upsells & cross-sells",
      "Custom bundle builder",
    ],
  },
  {
    title: "App Replacement Development",
    description:
      "Shopify apps add up fast, $20 here, $49 there, and they slow your store down. I build the same functionality as native, lightweight code. One-time cost, zero monthly fees.",
    items: [
      "Wishlist (no app)",
      "Infinite scroll (no app)",
      "Product badges & labels",
      "Size / colour swatches",
      "Recently viewed products",
    ],
  },
  {
    title: "Shopify Plus Development",
    description:
      "20+ Shopify Plus projects delivered. I work confidently with checkout UI extensions, Shopify Functions, and complex multi-market setups that require deeper platform knowledge.",
    items: [
      "Checkout UI extensions",
      "Custom checkout flows",
      "Shopify Functions",
      "B2B / wholesale features",
      "Multi-market / multi-language",
    ],
  },
];

const whySpecialist = [
  {
    step: "1",
    title: "Shopify-Only Focus",
    description:
      "I work exclusively in Shopify. That depth means I know the platform edge cases, performance pitfalls, and undocumented APIs that a generalist misses.",
  },
  {
    step: "2",
    title: "You Talk to the Developer",
    description:
      "No project managers, no account handlers, no translation layer. You explain something once, directly to the person writing the code.",
  },
  {
    step: "3",
    title: "Revenue-First Thinking",
    description:
      "Features are only worth building if they move a metric, conversion rate, AOV, or margin. I help you decide what to build before writing a line of code.",
  },
];

const auditItems = [
  "Conversion bottlenecks",
  "Missed upsell opportunities",
  "Speed & Core Web Vitals issues",
  "App replacement opportunities",
  "Mobile UX problems",
  "Estimated revenue impact",
];

const servicesFaqs = [
  {
    question: "What kind of Shopify stores do you work with?",
    answer:
      "I work with Shopify and Shopify Plus stores of all sizes, from DTC brands doing their first $1M to established merchants scaling past $10M. My focus is always on revenue impact: conversion rate, average order value, and store performance.",
  },
  {
    question: "Do you replace Shopify apps with custom code?",
    answer:
      "Yes. Many common Shopify apps, wishlists, bundle builders, frequently bought together, infinite scroll, product badges, can be rebuilt as lightweight custom code. This cuts monthly app fees and usually results in a faster, cleaner store.",
  },
  {
    question: "How do I get started?",
    answer:
      "The easiest way is to request a free Shopify revenue audit. Share your store URL and I'll personally review it and identify your highest-impact opportunities, conversion bottlenecks, missed upsell moments, speed issues, and app replacement candidates.",
  },
  {
    question: "Do you work with agencies or only direct clients?",
    answer:
      "I work directly with store owners and brands, no agencies, no middlemen. You talk to the developer doing the work from day one.",
  },
  {
    question: "Do you offer ongoing support after a project?",
    answer:
      "Yes. I offer ongoing retainer support for stores that need regular development work, bug fixes, and iterative improvements after the initial project.",
  },
];
---

<Layout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(professionalServiceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <Header />

  <main id="main-content">
    <section id="hero" class="pt-12 pb-6 sm:pt-16">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Shopify Development
      </p>

      <h1 class="my-4 inline-block text-2xl font-bold sm:my-6 sm:text-3xl">
        Services & Pricing
      </h1>

      <p class="max-w-xl">
        Custom Shopify development focused on revenue: conversion rate
        optimisation, AOV-boosting features, app replacement, and Shopify Plus
        solutions. 4+ years experience across 100+ stores, including 20+
        Shopify Plus projects.
      </p>

      <div class="mt-6 flex flex-col gap-4 sm:flex-row">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
          class="inline-block rounded bg-accent px-6 py-3 text-center text-sm font-medium text-background transition hover:opacity-90"
        >
          Get Free Revenue Audit
        </a>
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener"
          class="inline-block rounded border border-muted px-6 py-3 text-center text-sm font-medium transition hover:text-accent"
        >
          Book a Discovery Call
        </a>
      </div>
    </section>

    <Hr />

    <section id="what-i-build" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        What I Build
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Custom-coded Shopify solutions, no shortcuts.
      </h2>

      <p class="mb-8 max-w-xl text-sm text-gray-400">
        Every project is custom-coded, no page-builder shortcuts, no bloated
        apps, just clean, performant Liquid and JavaScript that your team can
        maintain.
      </p>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          services.map(({ title, description, items }) => (
            <div class="bg-muted/50 p-5 shadow-sm transition-shadow duration-200 hover:shadow-md">
              <h3 class="mb-2 text-lg font-semibold">{title}</h3>
              <p class="mb-4 text-sm text-gray-400">{description}</p>
              <ul class="space-y-1.5">
                {items.map(item => (
                  <li class="flex items-center gap-2 text-sm">
                    <span class="text-accent">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <Hr />

    <section id="why-specialist" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Why Hire a Specialist
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Not a generalist. A Shopify specialist.
      </h2>

      <ol class="grid grid-cols-1 gap-6">
        {
          whySpecialist.map(({ step, title, description }) => (
            <li class="flex gap-4">
              <span class="flex size-8 shrink-0 items-center justify-center bg-accent text-sm font-bold text-background">
                {step}
              </span>
              <div>
                <h3 class="font-semibold">{title}</h3>
                <p class="text-sm text-gray-400">{description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <Hr />

    <section id="free-audit" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Best Starting Point
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Free Shopify Revenue Audit
      </h2>

      <p class="mb-6 max-w-xl">
        Not sure where to start? Send me your store URL and I'll personally
        review your store and record a Loom video walking through:
      </p>

      <ul class="mb-6 grid max-w-lg grid-cols-1 gap-2 sm:grid-cols-2">
        {
          auditItems.map(item => (
            <li class="flex items-center gap-2 bg-muted/50 px-4 py-3 text-sm">
              <span class="text-accent">✓</span>
              {item}
            </li>
          ))
        }
      </ul>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-accent px-6 py-3 text-center text-sm font-medium text-background transition hover:opacity-90"
      >
        Request Free Audit
      </a>
      <p class="mt-3 text-sm text-gray-400">No obligation. No sales pressure.</p>
    </section>

    <Hr />

    <section id="faq" class="pt-12 pb-6">
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Frequently Asked Questions
      </h2>

      <div class="flex flex-col gap-3">
        {
          servicesFaqs.map(({ question, answer }) => (
            <details class="group bg-muted/50 p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">
                {question}
              </summary>
              <p class="mt-2 text-sm text-gray-400">{answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <Hr />

    <section id="final-cta" class="pt-12 pb-6 text-center">
      <h2 class="mb-4 text-2xl font-semibold tracking-wide">
        Ready to fix what's costing you revenue?
      </h2>
      <p class="mb-6">
        Get a free audit or book a call, either way, let's find the fastest
        path to results.
      </p>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
          class="inline-block rounded bg-accent px-6 py-3 text-center text-sm font-medium text-background transition hover:opacity-90"
        >
          Get Free Revenue Audit
        </a>
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener"
          class="inline-block rounded border border-muted px-6 py-3 text-center text-sm font-medium transition hover:text-accent"
        >
          Book a Discovery Call
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

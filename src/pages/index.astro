---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index">

    <!-- HERO -->
    <section id="hero" class="pt-8 pb-6">

      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-4xl">
        Shopify Conversion & AOV Optimization Expert
      </h1>

      <p class="max-w-2xl">
        I help Shopify store owners <strong>increase revenue by improving conversion rate, cart value, and store performance</strong>, without relying on heavy apps or expensive agencies.
      </p>

      <p class="mt-4 max-w-2xl">
        You work directly with me. No account managers, no delays, no bloated solutions.
      </p>

      <div class="mt-6 flex flex-col gap-4 sm:flex-row">
        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I am interested in your Shopify services"
          target="_blank"
          rel="noopener"
          class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
        >
          Chat on WhatsApp
        </a>

        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify store audit"
          target="_blank"
          rel="noopener"
          class="inline-block rounded border border-muted px-6 py-3 text-center text-sm font-medium text-white transition hover:border-white"
        >
          Get Free Store Audit
        </a>
      </div>

      <p class="mt-6 max-w-2xl text-sm text-foreground/60">
        Trusted by Shopify brands for custom Shopify development, performance optimization, and revenue-focused improvements.
      </p>

    </section>

    <Hr />

    <!-- INCREASE REVENUE SECTION -->
    <section class="pt-12 pb-6">

      <h2 class="mb-4 text-2xl font-semibold tracking-wide">
        Increase Revenue Without Increasing Ad Spend
      </h2>

      <p class="mb-4 max-w-2xl text-sm">
        If your store already gets traffic, the biggest opportunity is usually not more ads, it's improving how your store converts visitors into customers.
      </p>

      <p class="mb-4 max-w-2xl text-sm">I help Shopify stores improve:</p>

      <ul class="mb-4 space-y-2 max-w-2xl text-sm">
        <li>• Average Order Value (AOV)</li>
        <li>• Conversion Rate (CVR)</li>
        <li>• Cart Experience</li>
        <li>• Mobile UX</li>
        <li>• Store Speed</li>
        <li>• Customer Experience</li>
      </ul>

      <p class="max-w-2xl text-sm text-foreground/70">
        using lightweight custom Shopify solutions built directly into your theme.
      </p>

    </section>

    <Hr />

    <!-- FREE AUDIT OFFER -->
    <section id="free-audit" class="pt-12 pb-6">

      <h2 class="mb-4 text-2xl font-semibold tracking-wide">
        Free Shopify Revenue Audit
      </h2>

      <p class="mb-2 max-w-2xl text-sm">I'll personally review your Shopify store and identify:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm">
        <li>• what is hurting conversions</li>
        <li>• where customers drop off</li>
        <li>• missed upsell & bundle opportunities</li>
        <li>• apps slowing down your store</li>
        <li>• improvements that can increase cart value</li>
      </ul>

      <p class="mb-2 max-w-2xl text-sm font-medium">You'll receive:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm">
        <li>✓ A short Loom/video audit</li>
        <li>✓ Actionable recommendations</li>
        <li>✓ Estimated revenue impact</li>
        <li>✓ Suggestions for native app-free solutions</li>
      </ul>

      <p class="mb-6 max-w-2xl text-sm text-foreground/60">No pressure. No obligation.</p>

      <a
        href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify store audit"
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
      >
        Request Free Store Audit
      </a>

    </section>

    <Hr />

    <!-- WHAT I CAN IMPROVE -->
    <section class="pt-12 pb-6">

      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        What I Can Improve In Your Shopify Store
      </h2>

      <ul class="mb-4 space-y-2 max-w-2xl text-sm">
        <li>✓ Cart drawer upsells</li>
        <li>✓ Frequently bought together</li>
        <li>✓ Product bundles</li>
        <li>✓ Sticky add-to-cart</li>
        <li>✓ Free shipping progress bars</li>
        <li>✓ Product page optimization</li>
        <li>✓ Mobile conversion improvements</li>
        <li>✓ Speed optimization</li>
        <li>✓ App replacement with native features</li>
        <li>✓ Custom Shopify functionality</li>
      </ul>

      <p class="max-w-2xl text-sm text-foreground/60">
        Everything is built with performance and long-term maintainability in mind.
      </p>

    </section>

    <Hr />

    <!-- WHY WORK WITH ME -->
    <section class="pt-12 pb-6">

      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Why Store Owners Work With Me
      </h2>

      <ul class="mb-4 space-y-2 max-w-2xl text-sm">
        <li>• 4+ years of Shopify development experience</li>
        <li>• Direct communication on WhatsApp</li>
        <li>• Fast turnaround & reliable support</li>
        <li>• Lightweight custom solutions instead of heavy apps</li>
        <li>• Focused on revenue growth, not just design changes</li>
        <li>• Ongoing technical support available</li>
      </ul>

    </section>

    <Hr />

    <!-- RETAINER -->
    <section id="retainer" class="pt-12 pb-6">

      <h2 class="mb-2 text-2xl font-semibold tracking-wide">
        Monthly Shopify Retainer
      </h2>

      <p class="mb-4 max-w-2xl text-sm">
        Need a reliable Shopify developer available every month?
      </p>

      <p class="mb-2 max-w-2xl text-sm">Perfect for growing stores that need:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm">
        <li>• ongoing improvements</li>
        <li>• bug fixes</li>
        <li>• conversion optimization</li>
        <li>• custom features</li>
        <li>• landing page updates</li>
        <li>• performance improvements</li>
      </ul>

      <p class="mb-2 max-w-2xl text-sm text-foreground/70">
        Starting from <strong>$500/month</strong>
      </p>

      <p class="mb-2 max-w-2xl text-sm font-medium">Includes:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm">
        <li>✓ Priority support</li>
        <li>✓ Direct WhatsApp communication</li>
        <li>✓ Flexible monthly hours</li>
        <li>✓ No long-term contracts</li>
      </ul>

      <a
        href="https://calendly.com/saadgfx97/shopify-theme-development"
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
      >
        Book Free 15-Min Call
      </a>

    </section>

    <Hr />

    <!-- BLOG CONTENT -->

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">
              Recent Shopify Development Articles
            </h2>

            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>

          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">

          <h2 class="text-2xl font-semibold tracking-wide">
            {featuredPosts.length === 0 ? "Recent Shopify Development Articles" : "More Articles"}
          </h2>

          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>

        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        View All Articles
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <Hr />

    <!-- FAQ -->
    <section id="faq" class="pt-12 pb-6">

      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Common Questions
      </h2>

      <dl class="max-w-2xl space-y-6 text-sm">

        <div>
          <dt class="font-semibold mb-1">Do you only work on Shopify?</dt>
          <dd class="text-foreground/70">Yes. I specialize only in Shopify development and optimization.</dd>
        </div>

        <div>
          <dt class="font-semibold mb-1">Do I need Shopify Plus?</dt>
          <dd class="text-foreground/70">No. Most improvements work perfectly on regular Shopify plans.</dd>
        </div>

        <div>
          <dt class="font-semibold mb-1">Will I need additional apps?</dt>
          <dd class="text-foreground/70">Usually no. I prefer building lightweight native solutions directly into your theme whenever possible.</dd>
        </div>

        <div>
          <dt class="font-semibold mb-1">How quickly can we start?</dt>
          <dd class="text-foreground/70">Usually within 1–3 days depending on workload.</dd>
        </div>

        <div>
          <dt class="font-semibold mb-1">Do you work with small stores?</dt>
          <dd class="text-foreground/70">Yes. I primarily work with small and growing Shopify brands.</dd>
        </div>

      </dl>

    </section>

    <Hr />

    <!-- FINAL CTA -->
    <section class="pt-12 pb-12 text-center">

      <p class="mb-2 max-w-2xl mx-auto text-sm text-foreground/70">
        Your store may already have enough traffic.
      </p>

      <p class="mb-2 max-w-2xl mx-auto text-sm text-foreground/70">
        The next step is improving how well it converts.
      </p>

      <p class="mb-8 max-w-2xl mx-auto text-sm">
        Let's identify what's limiting your sales and how to fix it.
      </p>

      <a
        href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify store audit"
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
      >
        Get Free Shopify Revenue Audit
      </a>

    </section>

  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;

    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

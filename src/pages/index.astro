---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index">

    <!-- HERO -->
    <section id="hero" class="pt-8 pb-6">

      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-4xl">
        Shopify Stores Already Getting Traffic?<br />
        Let's Increase Your Revenue Without Increasing Ad Spend.
      </h1>

      <p class="mb-4 max-w-2xl">
        You already paid to get visitors to your store.<br />
        The problem is most Shopify stores lose revenue because of:
      </p>

      <ul class="mb-6 space-y-1 max-w-2xl text-sm text-foreground/80">
        <li>• low conversion rates</li>
        <li>• weak product pages</li>
        <li>• poor mobile experience</li>
        <li>• slow themes</li>
        <li>• missing upsells & bundles</li>
        <li>• too many heavy apps</li>
      </ul>

      <p class="mb-2 max-w-2xl text-sm">
        I help Shopify store owners fix those problems using lightweight custom Shopify development focused on one thing:
      </p>

      <p class="mb-8 max-w-2xl text-lg font-semibold">
        More Revenue Per Visitor
      </p>

      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify store audit"
          target="_blank"
          rel="noopener"
          class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
        >
          Get Free Revenue Audit
        </a>

        <a
          href="https://wa.me/+923314002075?text=Hi Saad, I am interested in your Shopify services"
          target="_blank"
          rel="noopener"
          class="inline-block rounded border border-muted px-6 py-3 text-center text-sm font-medium text-white transition hover:border-white"
        >
          Chat on WhatsApp
        </a>
      </div>

    </section>

    <Hr />

    <!-- FREE AUDIT OFFER -->
    <section id="free-audit" class="pt-12 pb-6">

      <p class="mb-2 max-w-2xl text-sm font-medium text-foreground/60 uppercase tracking-widest">Here's The Offer</p>

      <h2 class="mb-4 text-2xl font-semibold tracking-wide">
        Free Shopify Revenue Opportunity Audit
      </h2>

      <p class="mb-4 max-w-2xl text-sm">I'll personally review your Shopify store and show you:</p>

      <ul class="mb-8 space-y-2 max-w-2xl text-sm">
        <li>✓ What is reducing your conversions</li>
        <li>✓ Where customers drop off</li>
        <li>✓ What is hurting mobile sales</li>
        <li>✓ Which apps are slowing your store</li>
        <li>✓ Missed upsell & AOV opportunities</li>
        <li>✓ Quick wins that can increase revenue</li>
      </ul>

      <p class="mb-2 max-w-2xl text-sm font-medium">You'll receive:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm text-foreground/80">
        <li>• A short Loom/video audit</li>
        <li>• Actionable recommendations</li>
        <li>• Estimated revenue impact</li>
        <li>• Suggestions for app-free native solutions</li>
      </ul>

      <p class="mb-6 max-w-2xl text-sm text-foreground/60">No obligation. No sales pressure.</p>

      <p class="mb-8 max-w-2xl text-sm font-semibold">
        If I Can't Find Revenue Opportunities, Don't Hire Me.
      </p>

      <p class="mb-4 max-w-2xl text-sm">Most Shopify stores are leaking revenue somewhere:</p>

      <ul class="mb-6 space-y-1 max-w-2xl text-sm text-foreground/80">
        <li>• product pages</li>
        <li>• cart experience</li>
        <li>• mobile UX</li>
        <li>• page speed</li>
        <li>• trust building</li>
        <li>• checkout flow</li>
        <li>• upsells & bundles</li>
      </ul>

      <p class="mb-8 max-w-2xl text-sm">I'll show you exactly where.</p>

    </section>

    <Hr />

    <!-- WHAT I IMPROVE -->
    <section class="pt-12 pb-6">

      <h2 class="mb-8 text-2xl font-semibold tracking-wide">
        What I Help Shopify Stores Improve
      </h2>

      <div class="grid gap-8 sm:grid-cols-3 max-w-2xl">

        <div>
          <h3 class="mb-3 font-semibold">Increase Average Order Value (AOV)</h3>
          <p class="mb-2 text-sm text-foreground/60">Using:</p>
          <ul class="space-y-1 text-sm text-foreground/80">
            <li>• frequently bought together</li>
            <li>• bundles</li>
            <li>• cart upsells</li>
            <li>• free shipping bars</li>
            <li>• smart cross-sells</li>
          </ul>
        </div>

        <div>
          <h3 class="mb-3 font-semibold">Increase Conversion Rate</h3>
          <p class="mb-2 text-sm text-foreground/60">By improving:</p>
          <ul class="space-y-1 text-sm text-foreground/80">
            <li>• product pages</li>
            <li>• mobile UX</li>
            <li>• cart experience</li>
            <li>• page speed</li>
            <li>• trust & buying flow</li>
          </ul>
        </div>

        <div>
          <h3 class="mb-3 font-semibold">Reduce App Costs</h3>
          <p class="text-sm text-foreground/80">
            I replace expensive apps with native Shopify solutions whenever possible.
          </p>
        </div>

      </div>

    </section>

    <Hr />

    <!-- WHY WORK WITH ME -->
    <section class="pt-12 pb-6">

      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Why Store Owners Work With Me
      </h2>

      <ul class="mb-8 space-y-2 max-w-2xl text-sm">
        <li>• 4+ years Shopify development experience</li>
        <li>• Direct communication with me</li>
        <li>• No agency layers or account managers</li>
        <li>• Fast turnaround</li>
        <li>• Performance-focused development</li>
        <li>• Lightweight, maintainable solutions</li>
        <li>• Revenue-focused improvements instead of random design edits</li>
      </ul>

      <h3 class="mb-4 text-lg font-semibold">Built For Growing Shopify Stores</h3>

      <p class="mb-2 max-w-2xl text-sm">This is ideal if your store:</p>

      <ul class="space-y-2 max-w-2xl text-sm">
        <li>✓ already gets traffic</li>
        <li>✓ already makes sales</li>
        <li>✓ wants higher conversion rates</li>
        <li>✓ wants better AOV</li>
        <li>✓ relies on too many apps</li>
        <li>✓ needs a technical Shopify growth partner</li>
      </ul>

    </section>

    <Hr />

    <!-- RETAINER -->
    <section id="retainer" class="pt-12 pb-6">

      <h2 class="mb-2 text-2xl font-semibold tracking-wide">
        Monthly Shopify Growth Retainer
      </h2>

      <p class="mb-4 max-w-2xl text-sm text-foreground/70">
        For stores that want ongoing improvements every month.
      </p>

      <p class="mb-2 max-w-2xl text-sm font-medium">Includes:</p>

      <ul class="mb-6 space-y-2 max-w-2xl text-sm text-foreground/80">
        <li>• Shopify development</li>
        <li>• conversion optimization</li>
        <li>• speed improvements</li>
        <li>• app replacement</li>
        <li>• feature development</li>
        <li>• ongoing technical support</li>
      </ul>

      <p class="mb-6 max-w-2xl text-sm text-foreground/70">
        Starting at <strong class="text-foreground">$500/month</strong>
      </p>

      <a
        href="https://calendly.com/saadgfx97/shopify-theme-development"
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
      >
        Book Free 15-Min Call
      </a>

    </section>

    <Hr />

    <!-- RECENT RESULTS -->
    <section class="pt-12 pb-6">

      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Recent Results
      </h2>

      <ul class="space-y-2 max-w-2xl text-sm">
        <li>✓ Replaced heavy apps with native Shopify features</li>
        <li>✓ Improved store speed & mobile UX</li>
        <li>✓ Built custom cart upsells & bundles</li>
        <li>✓ Added conversion-focused Shopify functionality</li>
        <li>✓ Helped stores improve AOV without additional ad spend</li>
      </ul>

    </section>

    <Hr />

    <!-- PROCESS -->
    <section class="pt-12 pb-6">

      <h2 class="mb-8 text-2xl font-semibold tracking-wide">
        Simple Process
      </h2>

      <div class="grid gap-6 sm:grid-cols-3 max-w-2xl text-sm">

        <div>
          <p class="mb-1 font-semibold">1. Request Free Audit</p>
          <p class="text-foreground/70">Send your store URL.</p>
        </div>

        <div>
          <p class="mb-1 font-semibold">2. Receive Actionable Recommendations</p>
          <p class="text-foreground/70">I'll review your store and identify revenue opportunities.</p>
        </div>

        <div>
          <p class="mb-1 font-semibold">3. Implement Improvements</p>
          <p class="text-foreground/70">You decide what you want help implementing.</p>
        </div>

      </div>

    </section>

    <Hr />

    <!-- BLOG CONTENT -->

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">
              Recent Shopify Development Articles
            </h2>

            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>

          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">

          <h2 class="text-2xl font-semibold tracking-wide">
            {featuredPosts.length === 0 ? "Recent Shopify Development Articles" : "More Articles"}
          </h2>

          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>

        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        View All Articles
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <Hr />

    <!-- FINAL CTA -->
    <section class="pt-12 pb-16 max-w-2xl">

      <p class="mb-2 text-foreground/70 text-sm">You probably don't need more traffic first.</p>
      <p class="mb-2 text-foreground/70 text-sm">You probably need a store that converts better.</p>

      <p class="mt-4 mb-8 text-sm">
        Let's find the fastest path to more revenue from the traffic you already have.
      </p>

      <a
        href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify store audit"
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-green-600 px-6 py-3 text-center text-sm font-medium text-white transition hover:bg-green-700"
      >
        Get Free Shopify Revenue Audit
      </a>

    </section>

  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;

    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const CALENDLY_URL = "https://calendly.com/saadgfx97/shopify-theme-development";

const shipItems = [
  "Landing Pages",
  "Product Page Optimization",
  "CRO Implementation",
  "A/B Test Development",
  "Checkout Improvements",
  "Cart Improvements",
  "Bundle Experiences",
  "Performance Optimization",
  "Theme Customization",
  "Custom Shopify Features",
  "Shopify Functions",
  "Checkout Extensibility",
];

const trustPoints = [
  "Trusted by 1800+ YouTube subscribers",
  "Shopify Plus Experience",
  "AI-Accelerated Delivery",
  "Clean, Scalable Code",
];

const whyHireMe = [
  "Faster turnaround",
  "Better architecture",
  "Cleaner code",
  "Fewer bugs",
  "Less technical debt",
];

const process = [
  {
    step: "1",
    title: "Prioritize",
    description: "We identify the highest-impact improvements.",
  },
  {
    step: "2",
    title: "Plan",
    description: "We define the fastest path to implementation.",
  },
  {
    step: "3",
    title: "Build",
    description:
      "I develop using modern Shopify best practices with AI-assisted workflows.",
  },
  {
    step: "4",
    title: "Launch",
    description: "Everything is tested before deployment.",
  },
  {
    step: "5",
    title: "Repeat",
    description: "Keep shipping improvements instead of growing a backlog.",
  },
];

const results = [
  {
    title: "Checkout Optimization",
    description:
      "Reduced friction during checkout with custom Shopify functionality.",
  },
  {
    title: "Custom Bundle Builder",
    description:
      "Built a native Shopify bundle experience without relying on third-party apps.",
  },
  {
    title: "Product Page Optimization",
    description:
      "Implemented CRO improvements that increased product page engagement.",
  },
  {
    title: "Theme Performance",
    description:
      "Removed unnecessary apps and optimized theme performance for faster loading.",
  },
  {
    title: "Shopify Plus Checkout",
    description:
      "Built custom checkout experiences using Checkout Extensibility.",
  },
];

const faqs = [
  {
    question: "Do you only work on Shopify?",
    answer: "Yes. I specialize exclusively in Shopify.",
  },
  {
    question: "Do you work with internal teams?",
    answer:
      "Absolutely. I work alongside ecommerce managers, designers, marketers, and consultants.",
  },
  {
    question: "Can you work with our consultant?",
    answer:
      "Yes. Many of my projects come from consultants who need a reliable Shopify implementation partner.",
  },
  {
    question: "Do you use AI?",
    answer:
      "Yes. AI helps me deliver faster. Every implementation is still reviewed, tested, and refined using years of Shopify development experience.",
  },
  {
    question: "Do you replace our agency?",
    answer:
      "No. I integrate with your existing team and become your Shopify implementation partner.",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="relative overflow-hidden py-[100px]">
      <div class="absolute inset-0 -z-10 hidden min-[990px]:block">
        <img
          src="/ecomwonk hero_image.png"
          alt=""
          class="h-full w-full object-contain object-right"
        />
      </div>

      <div class="min-[990px]:w-[50%]">
        <p class="text-sm font-semibold tracking-wide text-accent uppercase">
          For DTC Ecommerce Managers & Consultants
        </p>

        <h1 class="my-4 inline-block text-2xl font-bold sm:my-6 sm:text-3xl">
          Growth ideas stuck in development?
        </h1>

        <p>
          I help DTC ecommerce managers and consultants ship Shopify
          improvements faster, so campaigns launch on time, CRO ideas get
          implemented, and development never becomes the bottleneck.
        </p>

        <div class="mt-6 flex flex-col gap-4 sm:flex-row">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener"
            class="inline-block rounded bg-accent px-6 py-3 text-center text-sm font-medium text-background transition hover:opacity-90"
          >
            Book a Strategy Call
          </a>
          <a
            href="/portfolio"
            class="inline-block rounded border border-muted px-6 py-3 text-center text-sm font-medium transition hover:text-accent"
          >
            View Case Studies
          </a>
        </div>

        <p class="mt-8 text-sm font-medium text-gray-400">
          Trusted implementation partner for growing Shopify brands
        </p>

        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            trustPoints.map(point => (
              <li class="flex items-center gap-2 text-sm">
                <span class="text-accent">✓</span>
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Hr />

    <section id="problem" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        The Problem
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Does your team have more growth ideas than development capacity?
      </h2>

      <p class="mb-2">Every week your backlog grows.</p>
      <p class="mb-2">Marketing has campaigns ready.</p>
      <p class="mb-2">Your CRO consultant has recommendations.</p>
      <p class="mb-2">Leadership wants improvements.</p>
      <p class="mb-4">But development can't keep up.</p>

      <p class="mb-2">Projects slip.</p>
      <p class="mb-2">Campaigns launch late.</p>
      <p class="mb-4">Experiments never happen.</p>

      <p class="mb-2">The problem isn't ideas.</p>
      <p class="font-semibold">The problem is execution.</p>
    </section>

    <Hr />

    <section id="solution" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        My Solution
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        I help ecommerce teams turn ideas into production.
      </h2>

      <p class="mb-2">Whether it's launching a new landing page...</p>
      <p class="mb-2">Improving your product page...</p>
      <p class="mb-2">Building a custom bundle...</p>
      <p class="mb-2">Optimizing performance...</p>
      <p class="mb-4">Or replacing another unnecessary app...</p>

      <p>
        I help your team ship Shopify improvements quickly and
        reliably—without adding technical debt.
      </p>
    </section>

    <Hr />

    <section id="what-i-ship" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        What I Help You Ship
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Revenue-driving Shopify improvements.
      </h2>

      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          shipItems.map(item => (
            <li class="flex items-center gap-2 bg-muted/50 px-4 py-3 text-sm">
              <span class="text-accent">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="why-hire-me" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Why Clients Hire Me
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Experience gives confidence. AI gives speed.
      </h2>

      <p class="mb-2">Anyone can generate Shopify code.</p>
      <p class="mb-4">Very few developers know what belongs in production.</p>

      <p class="mb-2">I spent years building Shopify solutions before AI existed.</p>
      <p class="mb-4">
        Today I use AI to accelerate delivery, not replace engineering
        judgment.
      </p>

      <p class="mb-2">That means:</p>
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          whyHireMe.map(point => (
            <li class="flex items-center gap-2 text-sm">
              <span class="text-accent">✓</span>
              {point}
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="who-i-help" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Who I Help
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Built for ecommerce teams that need execution.
      </h2>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="bg-muted/50 p-5">
          <h3 class="mb-2 text-lg font-semibold">DTC Ecommerce Managers</h3>
          <p class="mb-2 text-sm text-gray-400">Your job is to grow the store.</p>
          <p class="mb-2 text-sm text-gray-400">
            Mine is making sure development never slows you down.
          </p>
          <p class="mb-1 text-sm text-gray-400">Launch campaigns faster.</p>
          <p class="mb-1 text-sm text-gray-400">Execute CRO roadmaps.</p>
          <p class="text-sm text-gray-400">Ship improvements consistently.</p>
        </div>

        <div class="bg-muted/50 p-5">
          <h3 class="mb-2 text-lg font-semibold">Ecommerce Consultants</h3>
          <p class="mb-2 text-sm text-gray-400">
            Recommendations only create value when they get implemented.
          </p>
          <p class="text-sm text-gray-400">
            I become your technical implementation partner, helping your
            clients see results faster.
          </p>
        </div>
      </div>
    </section>

    <Hr />

    <section id="how-we-work" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        How We Work
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        A simple process designed for speed.
      </h2>

      <ol class="grid grid-cols-1 gap-6">
        {
          process.map(({ step, title, description }) => (
            <li class="flex gap-4">
              <span class="flex size-8 shrink-0 items-center justify-center bg-accent text-sm font-bold text-background">
                {step}
              </span>
              <div>
                <h3 class="font-semibold">{title}</h3>
                <p class="text-sm text-gray-400">{description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <Hr />

    <section id="results" class="pt-12 pb-6">
      <p class="mb-2 text-sm font-semibold tracking-wide text-accent uppercase">
        Recent Results
      </p>
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Helping ecommerce teams move faster.
      </h2>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          results.map(({ title, description }) => (
            <li class="bg-muted/50 p-5 shadow-sm transition-shadow duration-200 hover:shadow-md">
              <h3 class="mb-2 text-lg font-semibold">{title}</h3>
              <p class="text-sm text-gray-400">{description}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-6">
        <LinkButton href="/portfolio">
          View All Case Studies
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section id="faq" class="pt-12 pb-6">
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">
        Common Questions
      </h2>

      <div class="flex flex-col gap-3">
        {
          faqs.map(({ question, answer }) => (
            <details class="group bg-muted/50 p-4">
              <summary class="cursor-pointer list-none font-semibold marker:content-none">
                {question}
              </summary>
              <p class="mt-2 text-sm text-gray-400">{answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <Hr />

    <section id="final-cta" class="pt-12 pb-6 text-center">
      <h2 class="mb-4 text-2xl font-semibold tracking-wide">
        Stop waiting on development.
      </h2>
      <p class="mb-2">Your team already knows what needs to be built.</p>
      <p class="mb-6">Let's make sure it gets shipped.</p>

      <a
        href={CALENDLY_URL}
        target="_blank"
        rel="noopener"
        class="inline-block rounded bg-accent px-6 py-3 text-center text-sm font-medium text-background transition hover:opacity-90"
      >
        Book a Strategy Call
      </a>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <Hr />
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

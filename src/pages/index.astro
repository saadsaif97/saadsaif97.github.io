---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 3);

function getImageSrc(ogImage: { src: string } | string | undefined): string | undefined {
  if (!ogImage) return undefined;
  if (typeof ogImage === "string") return ogImage;
  return ogImage.src ?? undefined;
}
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index">

    <!-- ═══ HERO ═══ -->
    <section id="hero" class="py-16 sm:py-20">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">

        <!-- Left: copy -->
        <div>
          <!-- Badge -->
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-green-800 bg-green-950/60 px-4 py-1.5 text-xs font-medium text-green-400">
            <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
            Shopify Developer &amp; Conversion Optimization Expert
          </div>

          <h1 class="mb-5 text-4xl font-bold leading-tight sm:text-5xl">
            Shopify Developer<br />Focused on<br />
            <span class="text-green-400">Revenue Growth</span>
          </h1>

          <p class="mb-6 max-w-lg text-foreground/70">
            I help Shopify stores increase conversion rate, improve AOV, and replace expensive apps with lightweight custom solutions.
          </p>

          <!-- Trust pills -->
          <div class="mb-8 flex flex-wrap gap-3">
            {[
              "4+ Years Experience",
              "Direct Communication",
              "No Agencies",
            ].map(label => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-green-800/60 bg-green-950/40 px-3 py-1 text-xs text-green-400">
                <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M10 3L5 8.5 2 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                {label}
              </span>
            ))}
          </div>

          <!-- CTAs -->
          <div class="mb-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-green-500 px-6 py-3 text-sm font-semibold text-black transition hover:bg-green-400"
            >
              Get Free Revenue Audit
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a
              href="https://wa.me/+923314002075?text=Hi Saad, I am interested in your Shopify services"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-700 bg-zinc-900/60 px-6 py-3 text-sm font-semibold text-foreground transition hover:border-zinc-500"
            >
              <svg class="h-4 w-4 text-green-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.116 1.535 5.842L.054 23.077a.75.75 0 00.92.92l5.235-1.481A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.66-.497-5.19-1.367l-.37-.216-3.836 1.086 1.087-3.836-.216-.37A9.946 9.946 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
              </svg>
              Chat on WhatsApp
            </a>
          </div>

          <p class="text-xs text-foreground/40 max-w-md">
            Trusted by Shopify brands for conversion optimization, custom features, and store performance improvements.
          </p>
        </div>

        <!-- Right: dashboard mockup -->
        <div class="hidden lg:block">
          <div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-4 shadow-2xl">

            <!-- Top row -->
            <div class="mb-3 grid grid-cols-2 gap-3">
              <!-- Revenue -->
              <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-4">
                <p class="mb-1 text-xs text-zinc-500">Total Revenue</p>
                <p class="text-2xl font-bold">$28,450</p>
                <div class="mt-1 flex items-center gap-1 text-xs text-green-400">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="18 15 12 9 6 15"/>
                  </svg>
                  18%
                </div>
                <!-- Sparkline -->
                <svg class="mt-3 h-12 w-full" viewBox="0 0 120 40" fill="none" preserveAspectRatio="none">
                  <polyline points="0,35 20,28 40,30 60,18 80,20 100,10 120,5" stroke="#4ade80" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>

              <!-- AOV & CVR stacked -->
              <div class="flex flex-col gap-3">
                <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-3">
                  <div class="mb-0.5 flex items-center justify-between">
                    <p class="text-xs text-zinc-500">Avg. Order Value</p>
                    <div class="rounded bg-green-950 p-1">
                      <svg class="h-3 w-3 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                      </svg>
                    </div>
                  </div>
                  <p class="text-lg font-bold">$96.40</p>
                  <p class="text-xs text-green-400">↑12% vs last 30 days</p>
                </div>
                <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-3">
                  <div class="mb-0.5 flex items-center justify-between">
                    <p class="text-xs text-zinc-500">Conversion Rate</p>
                    <div class="rounded bg-green-950 p-1">
                      <svg class="h-3 w-3 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="22,7 13.5,15.5 8.5,10.5 2,17"/>
                        <polyline points="16,7 22,7 22,13"/>
                      </svg>
                    </div>
                  </div>
                  <p class="text-lg font-bold">2.9%</p>
                  <p class="text-xs text-green-400">↑9% vs last 30 days</p>
                </div>
              </div>
            </div>

            <!-- Frequently Bought Together -->
            <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-4">
              <p class="mb-3 text-xs font-medium text-zinc-400">Frequently Bought Together</p>
              <div class="mb-3 flex items-center gap-2">
                {[1, 2, 3].map((_, i) => (
                  <div class="flex items-center gap-2">
                    <div class={`h-10 w-10 rounded-lg ${i === 0 ? "bg-zinc-700" : i === 1 ? "bg-zinc-600" : "bg-zinc-700"}`}></div>
                    {i < 2 && <span class="text-zinc-600 text-sm">+</span>}
                  </div>
                ))}
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm">
                  Total: <span class="font-semibold text-green-400">$89.00</span>
                  <span class="ml-1 text-xs text-zinc-600 line-through">$115.00</span>
                </span>
                <button class="rounded-lg bg-green-500 px-3 py-1.5 text-xs font-semibold text-black">
                  Add All To Cart
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PROBLEMS ═══ -->
    <section class="py-16">
      <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl">
        Most Shopify Stores Are Losing Revenue
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {[
          {
            color: "red",
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>`,
            title: "Low Conversion Rate",
            desc: "Visitors browse but leave without buying.",
          },
          {
            color: "orange",
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
            title: "Too Many Apps",
            desc: "Slow stores, higher costs, and poor performance.",
          },
          {
            color: "blue",
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
            title: "Weak Cart Experience",
            desc: "No upsells, bundles, or AOV optimization.",
          },
        ].map(({ color, icon, title, desc }) => (
          <div class={`rounded-xl border p-5 ${
            color === "red"
              ? "border-red-900/40 bg-red-950/20"
              : color === "orange"
              ? "border-orange-900/40 bg-orange-950/20"
              : "border-blue-900/40 bg-blue-950/20"
          }`}>
            <div class={`mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl ${
              color === "red"
                ? "bg-red-900/40 text-red-400"
                : color === "orange"
                ? "bg-orange-900/40 text-orange-400"
                : "bg-blue-900/40 text-blue-400"
            }`} set:html={icon}/>
            <h3 class="mb-1 font-semibold">{title}</h3>
            <p class="text-sm text-foreground/60">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ FREE AUDIT OFFER ═══ -->
    <section id="free-audit" class="py-8">
      <div class="rounded-2xl border border-green-900/60 bg-green-950/30 p-8 sm:p-10">

        <div class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-green-400">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Here's The Offer
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">

          <!-- Left: identify -->
          <div>
            <h2 class="mb-3 text-3xl font-bold">Free Shopify Revenue Audit</h2>
            <p class="mb-6 text-sm text-foreground/70">
              I'll personally review your Shopify store and identify:
            </p>
            <div class="grid grid-cols-2 gap-x-6 gap-y-3">
              {[
                "Conversion bottlenecks",
                "Speed problems",
                "Missed upsell opportunities",
                "App replacement opportunities",
                "Mobile UX issues",
              ].map(item => (
                <div class="flex items-center gap-2 text-sm">
                  <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-500/20">
                    <svg class="h-3 w-3 text-green-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="2,6 5,9 10,3"/>
                    </svg>
                  </div>
                  {item}
                </div>
              ))}
            </div>
          </div>

          <!-- Right: receive + Shopify icon -->
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="mb-4 font-semibold">You'll receive:</p>
              <div class="space-y-4">
                {[
                  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`, text: "Loom / video audit" },
                  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`, text: "Actionable recommendations" },
                  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`, text: "Estimated revenue impact" },
                  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`, text: "Suggestions for app-free solutions" },
                ].map(({ icon, text }) => (
                  <div class="flex items-center gap-3 text-sm text-foreground/80">
                    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-green-800/50 bg-green-950/60 text-green-400" set:html={icon}/>
                    {text}
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>

        <!-- CTA -->
        <div class="mt-10 border-t border-green-900/40 pt-8 text-center">
          <a
            href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg bg-green-500 px-8 py-3.5 text-sm font-semibold text-black transition hover:bg-green-400"
          >
            Request Free Audit
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <p class="mt-3 text-xs text-foreground/40">No obligation. No sales pressure.</p>
        </div>

      </div>
    </section>

    <!-- ═══ WHAT I HELP IMPROVE ═══ -->
    <section class="py-16">
      <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl">What I Help Stores Improve</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
            title: "Increase Conversion Rate",
            desc: "Better product pages, mobile UX & checkout flow.",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
            title: "Increase Average Order Value",
            desc: "Upsells, bundles, cross-sells & cart optimization.",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
            title: "Improve Store Speed",
            desc: "Remove app bloat & improve Core Web Vitals.",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
            title: "Increase Profit Margins",
            desc: "Replace expensive apps with native solutions.",
          },
        ].map(({ icon, title, desc }) => (
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 transition hover:border-green-900/60">
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-green-800/50 bg-green-950/60 text-green-400" set:html={icon}/>
            <h3 class="mb-2 font-semibold">{title}</h3>
            <p class="text-sm text-foreground/60">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ WHY CHOOSE ═══ -->
    <section class="py-16">
      <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl">Why Store Owners Choose EcomWonk</h2>
      <div class="grid grid-cols-3 gap-4 sm:grid-cols-6">
        {[
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
            label: "Shopify-Only Specialist",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
            label: "Direct Developer Communication",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
            label: "Lightweight Custom Solutions",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
            label: "Revenue-Focused Improvements",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
            label: "Fast Turnaround",
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
            label: "Long-Term Support",
          },
        ].map(({ icon, label }) => (
          <div class="flex flex-col items-center gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 p-4 text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-green-800/50 bg-green-950/60 text-green-400" set:html={icon}/>
            <p class="text-xs font-medium leading-snug text-foreground/80">{label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ SIMPLE PROCESS ═══ -->
    <section class="py-16">
      <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl">Simple Process</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            step: 1,
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
            title: "Request Free Audit",
            desc: "Send your store URL and brief details.",
          },
          {
            step: 2,
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
            title: "Receive Actionable Recommendations",
            desc: "I'll review your store and identify opportunities.",
          },
          {
            step: 3,
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
            title: "Implement Improvements",
            desc: "You decide what you want help implementing.",
          },
          {
            step: 4,
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
            title: "Increase Conversions & AOV",
            desc: "Get more revenue from the traffic you already have.",
          },
        ].map(({ step, icon, title, desc }, i) => (
          <div class="relative flex flex-col gap-4 rounded-xl border border-zinc-800 bg-zinc-900/50 p-6">
            {/* Arrow between steps */}
            {i < 3 && (
              <div class="absolute -right-3 top-1/2 z-10 hidden -translate-y-1/2 lg:flex h-6 w-6 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-zinc-500">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </div>
            )}
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-green-500 text-sm font-bold text-black">{step}</div>
            <div class="flex h-10 w-10 items-center justify-center text-green-400" set:html={icon}/>
            <div>
              <h3 class="mb-1 font-semibold">{title}</h3>
              <p class="text-sm text-foreground/60">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ LATEST ARTICLES ═══ -->
    <section class="py-16">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold sm:text-3xl">Latest Shopify Insights</h2>
        <a href="/posts/" class="flex items-center gap-1 text-sm font-medium text-green-400 transition hover:text-green-300">
          View all articles
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {recentPosts.map(post => {
            const imgSrc = getImageSrc(post.data.ogImage);
            return (
              <a
                href={getPath(post.id, post.filePath)}
                class="group flex flex-col overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/50 transition hover:border-zinc-700"
              >
                {/* Thumbnail */}
                <div class="h-40 w-full overflow-hidden bg-zinc-800">
                  {imgSrc ? (
                    <img
                      src={imgSrc}
                      alt={post.data.title}
                      class="h-full w-full object-cover transition group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-green-950 to-zinc-900">
                      <svg class="h-10 w-10 text-green-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
                      </svg>
                    </div>
                  )}
                </div>
                {/* Content */}
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <h3 class="font-semibold leading-snug group-hover:text-green-400 transition">{post.data.title}</h3>
                  <p class="text-xs text-foreground/50 line-clamp-2">{post.data.description}</p>
                  <p class="mt-auto pt-3 text-xs text-foreground/40">
                    {post.data.pubDatetime.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" })}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-foreground/50">No articles yet.</p>
      )}
    </section>

    <!-- ═══ FINAL CTA BANNER ═══ -->
    <section class="pb-20">
      <div class="flex flex-col items-start justify-between gap-8 rounded-2xl border border-green-900/60 bg-green-950/30 p-8 sm:flex-row sm:items-center sm:p-10">
        <div class="flex items-start gap-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-green-800/50 bg-green-950 text-green-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L8.5 8.5 2 9.27l5 4.87L5.82 21 12 17.77 18.18 21l-1.18-6.86L22 9.27l-6.5-.77L12 2z"/>
            </svg>
          </div>
          <div>
            <p class="mb-1 font-bold text-foreground">Your Store Probably Doesn't Need More Traffic First.</p>
            <p class="mb-2 font-semibold text-green-400">It Probably Needs a Store That Converts Better.</p>
            <p class="text-sm text-foreground/60">Let's find the fastest path to more revenue from the traffic you already have.</p>
          </div>
        </div>
        <div class="shrink-0 text-center">
          <a
            href="https://wa.me/+923314002075?text=Hi Saad, I'd like a free Shopify revenue audit"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg bg-green-500 px-6 py-3 text-sm font-semibold text-black transition hover:bg-green-400 whitespace-nowrap"
          >
            Get Free Shopify Revenue Audit
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <p class="mt-2 text-xs text-foreground/40">No obligation. Just actionable insights.</p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

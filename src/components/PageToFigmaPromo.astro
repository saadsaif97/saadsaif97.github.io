---
const YT_ID = "KHcY7sBlfLo"; // TODO: replace with the page2figma YouTube video ID
const YT_URL = `https://www.youtube.com/watch?v=${YT_ID}&utm_source=ecomwonk_website&utm_medium=promo_banner&utm_campaign=page2figma_promo`;
const FIGMA_URL = `https://page2figma.com/?utm_source=ecomwonk_website&utm_medium=promo_banner&utm_campaign=page2figma_promo`;
const IMAGE = "/html-to-figma.png"; // drop your promo image at public/page2figma-promo.png
---

<div class="my-8 overflow-hidden rounded-xl border border-border bg-muted/40">
  <a href={FIGMA_URL} target="_blank" rel="noopener noreferrer" class="group relative block">
    <img
      src={IMAGE}
      alt="Convert any HTML page to Figma with page2figma.com"
      class="w-full object-cover"
      loading="lazy"
    />
    <!-- Play button overlay linking to the YouTube video -->
    <a href={YT_URL} target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-center justify-center bg-black/30 transition-colors group-hover:bg-black/40">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 shadow-lg transition-transform group-hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7 translate-x-0.5 fill-white" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </a>
    <div class="absolute top-3 right-3 rounded bg-black/60 px-2 py-1 text-xs font-medium text-white">
      AD
    </div>
  </a>

  <div class="p-4">
    <p class="text-sm font-semibold leading-snug text-foreground">
      Convert any HTML to Figma — just paste a URL and press convert.
    </p>
    <a
      href={FIGMA_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-background transition-opacity hover:opacity-90"
    >
      Try page2figma.com
    </a>
  </div>
</div>

---
const trainingUrl = "/shopify-ai-training";
const phoneNumber = "+923037338357";
const message =
  "Hi Saad, I'm interested in the Shopify Development Training with AI and I'd like to know more.";
const whatsappLink = `https://wa.me/923037338357?text=${encodeURIComponent(message)}`;
---

<aside
  id="sticky-offer-card"
  class="fixed top-24 hidden xl:flex flex-col gap-4 rounded-xl border border-foreground/10 bg-background p-5 shadow-sm"
  style="left: 0; width: 350px; top: 50%; transform: translateY(-50%);"
>
  <p class="text-xs font-semibold uppercase tracking-wider text-foreground/50">
    New AI Course
  </p>

  <h3 class="text-lg font-semibold leading-snug text-foreground">
    Shopify Development Training with AI
  </h3>

  <p class="text-sm text-foreground/80">
    The most comprehensive training online. Themes, Figma to Shopify, Plus
    apps, Functions, Flow, and debugging, all with AI.
  </p>

  <ul class="space-y-2 text-sm text-foreground/80">
    <li>✓ Learn Shopify Plus-level skills</li>
    <li>✓ Figma to Shopify with AI</li>
    <li>✓ App & checkout extension development</li>
    <li>✓ Client work & live debugging</li>
  </ul>

  <a
    href={trainingUrl}
    class="flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90"
  >
    Reserve My Seat, $20
  </a>

  <p class="text-center text-xs text-foreground/50">
    Launch price. Pakistan students: 3,700 PKR.
  </p>

  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    class="text-center text-xs font-medium text-foreground/60 transition-colors hover:text-accent"
  >
    Questions? Ask on WhatsApp
  </a>
</aside>